    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@iconify/iconify": "^3.1.1",
    "@types/aos": "^3.0.7",
    "aos": "^2.3.4",
    "date-fns": "^4.1.0",
    "lucide-angular": "^1.0.0",
    "marked": "^17.0.6",
    "ngx-markdown": "^21.2.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.3",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0"
